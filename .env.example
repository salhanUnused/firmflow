# Copy to .env.local (or Vercel project env).

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required in production so sessions and firmware signatures stay stable
# across serverless instances.
SESSION_SECRET=change-me-to-a-long-random-string
FIRMWARE_SIGNING_SECRET=change-me-to-another-long-random-string

# Optional but required on Vercel if you want data to survive deploys.
# Create a Supabase project, run supabase/firmflow.sql, then paste:
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Kept for compatibility with earlier local prototypes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
